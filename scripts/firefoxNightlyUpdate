#!/bin/bash
# Update the local Nightly build to the latest mozilla-central, rebuild it, and
# install native macOS Look Up on top (from FirefoxOSXDictionaryLookUp).
#
# Look Up is no longer a source patch: it is installed into the built .app as
# a startup script, so upstream changes cannot make the update or build fail.
set -euo pipefail

# Resolve symlinks so /usr/local/bin/firefoxNightlyUpdate finds this package.
LOOKUP=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
SRC="${FIREFOX_SRC:-/Users/morpheous/APPLICATIONS_2/Firefox/mozilla-unified}"

check_only=false
case "${1:-}" in
    "") ;;
    --check-only) check_only=true ;;
    *) echo "Usage: firefoxNightlyUpdate [--check-only]" >&2; exit 2 ;;
esac
cd "$SRC" || exit 1

git fetch origin
upstream_revision=$(git rev-parse --verify 'origin/bookmarks/central^{commit}')

# Warn only: a missing internal can hide the Look Up item but never breaks Nightly.
FIREFOX_SRC="$SRC" "$LOOKUP/check-compat.sh" "$upstream_revision" || true
if [ "$check_only" = true ]; then
    exit 0
fi

git reset --hard "$upstream_revision"
# Left behind by the old patch-based Look Up (untracked, so reset keeps it).
rm -f browser/base/content/test/browser-contextMenu/browser_contextmenu_lookup_dictionary.js

# NOTE: the old line here was
#   touch "$SRC/obj-x86_64-apple-darwin22.5.0/CLOBBER"
# That objdir does not exist (the real ones are darwin24.5.0 / darwin24.6.0 --
# the name tracks the macOS kernel version), so the touch always failed and no
# clobber ever happened. Uncomment below if you actually want a forced clobber:
# for o in "$SRC"/obj-*/; do touch "$o/CLOBBER"; done

./mach build

# WebGL fix -- must run after every build. See scripts/fix-macos-helpers.sh.
"$LOOKUP/scripts/fix-macos-helpers.sh" "$SRC"

FIREFOX_SRC="$SRC" "$LOOKUP/install.sh"

echo "==> Done. Verify at about:support -> Graphics (GPU Process should be present,"
echo "    'Compositing' should read WebRender, not WebRender (Software))."
echo "    Restart Nightly to load the update."
